rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function consumer() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'apple.com']
        && request.auth.token.email is string;
    }

    function handler() {
      return consumer()
        && exists(/databases/$(database)/documents/handlerAccounts/$(request.auth.token.email))
        && get(/databases/$(database)/documents/handlerAccounts/$(request.auth.token.email)).data.email == request.auth.token.email;
    }

    function consumerEvidenceUpdate(complaintId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let imagePath = request.resource.data.imagePath;
      let documentPath = request.resource.data.documentPath;
      let videoPath = request.resource.data.videoPath;
      let complaintAudioPath = request.resource.data.get('complaintAudioPath', '');
      return consumer()
        && resource.data.ownerUid == request.auth.uid
        && changed.hasAny(['imageUrl', 'imagePath', 'documentUrl', 'documentPath', 'documentName', 'videoUrl', 'videoPath', 'videoName', 'complaintAudioUrl', 'complaintAudioPath'])
        && changed.hasOnly(['imageUrl', 'imagePath', 'documentUrl', 'documentPath', 'documentName', 'videoUrl', 'videoPath', 'videoName', 'complaintAudioUrl', 'complaintAudioPath'])
        && request.resource.data.status == resource.data.status
        && request.resource.data.response == resource.data.response
        && request.resource.data.responseAudioUrl == resource.data.responseAudioUrl
        && request.resource.data.responseAudioPath == resource.data.responseAudioPath
        && imagePath is string
        && (
          (imagePath == '' && request.resource.data.imageUrl == '')
          || (
            imagePath.matches('^complaints/[^/]+/[^/]+/image$')
            && imagePath.split('/')[1] == request.auth.uid
            && imagePath.split('/')[2] == complaintId
            && request.resource.data.imageUrl.matches('^https://firebasestorage.googleapis.com/.*$')
          )
        )
        && documentPath is string
        && (
          (
            documentPath == ''
            && request.resource.data.documentUrl == ''
            && request.resource.data.documentName == ''
          )
          || (
            documentPath.matches('^complaints/[^/]+/[^/]+/document$')
            && documentPath.split('/')[1] == request.auth.uid
            && documentPath.split('/')[2] == complaintId
            && request.resource.data.documentUrl.matches('^https://firebasestorage.googleapis.com/.*$')
            && request.resource.data.documentName is string
            && request.resource.data.documentName.size() <= 255
          )
        )
        && videoPath is string
        && (
          (
            videoPath == ''
            && request.resource.data.videoUrl == ''
            && request.resource.data.videoName == ''
          )
          || (
            videoPath.matches('^complaints/[^/]+/[^/]+/video$')
            && videoPath.split('/')[1] == request.auth.uid
            && videoPath.split('/')[2] == complaintId
            && request.resource.data.videoUrl.matches('^https://firebasestorage.googleapis.com/.*$')
            && request.resource.data.videoName is string
            && request.resource.data.videoName.size() <= 255
          )
        )
        && (resource.data.imagePath == '' || imagePath == resource.data.imagePath)
        && (resource.data.documentPath == '' || documentPath == resource.data.documentPath)
        && (resource.data.videoPath == '' || videoPath == resource.data.videoPath)
        && complaintAudioPath is string
        && (
          (
            complaintAudioPath == ''
            && request.resource.data.get('complaintAudioUrl', '') == ''
          )
          || (
            complaintAudioPath.matches('^complaints/[^/]+/[^/]+/audio$')
            && complaintAudioPath.split('/')[1] == request.auth.uid
            && complaintAudioPath.split('/')[2] == complaintId
            && request.resource.data.get('complaintAudioUrl', '').matches('^https://firebasestorage.googleapis.com/.*$')
          )
        )
        && (
          resource.data.get('complaintAudioPath', '') == ''
          || complaintAudioPath == resource.data.complaintAudioPath
        );
    }

    match /handlers/{mobile} {
      allow read, write: if false;
    }

    match /handlerAccounts/{email} {
      allow get: if signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'apple.com']
        && request.auth.token.email == email;
      allow list, create, update, delete: if false;
    }

    match /securityLoginEvents/{eventId} {
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'apple.com']
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'provider', 'loginAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'displayName', 'provider', 'loginAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.provider == request.auth.token.firebase.sign_in_provider
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 200
        && request.resource.data.loginAt == request.time;
      allow read, update, delete: if false;
    }

    match /complaints/{complaintId} {
      allow create: if consumer()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.consumerEmail == request.auth.token.email
        && request.resource.data.id == complaintId
        && request.resource.data.status == 'Pending'
        && request.resource.data.response == ''
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'location', 'issue', 'details',
          'ownerUid', 'consumerEmail', 'status', 'response', 'imageUrl', 'imagePath',
          'documentUrl', 'documentPath', 'documentName', 'created',
          'updated', 'createdAt', 'videoUrl', 'videoPath', 'videoName',
          'locationState', 'locationVillage', 'responseAudioUrl',
          'responseAudioPath', 'handlerEmail', 'complaintAudioUrl',
          'complaintAudioPath'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'name', 'location', 'issue', 'details',
          'ownerUid', 'consumerEmail', 'status', 'response', 'imageUrl', 'imagePath',
          'documentUrl', 'documentPath', 'documentName', 'created',
          'updated', 'createdAt', 'videoUrl', 'videoPath', 'videoName',
          'locationState', 'locationVillage', 'responseAudioUrl',
          'responseAudioPath', 'handlerEmail', 'complaintAudioUrl',
          'complaintAudioPath'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.consumerEmail is string
        && request.resource.data.consumerEmail.size() <= 320
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 300
        && request.resource.data.issue is string
        && request.resource.data.issue.size() <= 100
        && request.resource.data.details is string
        && request.resource.data.details.size() > 0
        && request.resource.data.details.size() <= 1000
        && request.resource.data.response is string
        && request.resource.data.response == ''
        && request.resource.data.imageUrl is string
        && request.resource.data.imagePath is string
        && request.resource.data.documentUrl is string
        && request.resource.data.documentPath is string
        && request.resource.data.documentName is string
        && request.resource.data.videoUrl is string
        && request.resource.data.videoPath is string
        && request.resource.data.videoName is string
        && request.resource.data.responseAudioUrl is string
        && request.resource.data.responseAudioPath is string
        && request.resource.data.complaintAudioUrl is string
        && request.resource.data.complaintAudioPath is string
        && request.resource.data.handlerEmail is string
        && request.resource.data.handlerEmail.size() <= 320
        && request.resource.data.locationState is string
        && request.resource.data.locationState.size() <= 100
        && request.resource.data.locationVillage is string
        && request.resource.data.locationVillage.size() <= 200
        && request.resource.data.created is string
        && request.resource.data.updated is string;

      allow get, list: if handler()
        || (consumer() && resource.data.ownerUid == request.auth.uid);

      allow update: if (
          handler()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'status', 'response', 'updated',
                'responseAudioUrl', 'responseAudioPath', 'handlerEmail'
            ])
          && request.resource.data.status in [
            'Pending', 'Under Review', 'Investigation Started',
            'Forwarded to Department', 'Information Requested',
            'Escalated', 'Resolved', 'Rejected'
          ]
          && request.resource.data.response is string
          && request.resource.data.response.size() <= 1000
          && request.resource.data.handlerEmail is string
          && request.resource.data.handlerEmail.size() <= 320
          && (
            (
              request.resource.data.responseAudioPath == ''
              && request.resource.data.responseAudioUrl == ''
            )
            || (
              request.resource.data.responseAudioPath.matches(
                '^complaints/[^/]+/[^/]+/response-audio-[^/]+$'
              )
              && request.resource.data.responseAudioPath.split('/')[1]
                == resource.data.ownerUid
              && request.resource.data.responseAudioPath.split('/')[2]
                == complaintId
              && request.resource.data.responseAudioUrl.matches(
                '^https://firebasestorage.googleapis.com/.*$'
              )
            )
          )
        )
        || consumerEvidenceUpdate(complaintId);

      allow delete: if false;
    }

    match /smsNotifications/{notificationId} {
      allow read, write: if false;
    }

    match /emailNotifications/{notificationId} {
      allow read, write: if false;
    }

    match /uiTranslationCache/{cacheId} {
      allow read, write: if false;
    }

    match /uiTranslationRateLimits/{requestId} {
      allow read, write: if false;
    }

  }
}
