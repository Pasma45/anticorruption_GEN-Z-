rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function consumer() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'apple.com']
        && request.auth.token.email is string;
    }

    function handler() {
      return consumer()
        && exists(/databases/$(database)/documents/handlerAccounts/$(request.auth.token.email))
        && get(/databases/$(database)/documents/handlerAccounts/$(request.auth.token.email)).data.email == request.auth.token.email;
    }

    function consumerEvidenceUpdate(complaintId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let imagePath = request.resource.data.imagePath;
      let documentPath = request.resource.data.documentPath;
      return consumer()
        && resource.data.ownerUid == request.auth.uid
        && changed.hasAny(['imageUrl', 'imagePath', 'documentUrl', 'documentPath', 'documentName'])
        && changed.hasOnly(['imageUrl', 'imagePath', 'documentUrl', 'documentPath', 'documentName'])
        && request.resource.data.status == resource.data.status
        && request.resource.data.response == resource.data.response
        && imagePath is string
        && (
          (imagePath == '' && request.resource.data.imageUrl == '')
          || (
            imagePath.matches('^complaints/[^/]+/[^/]+/image$')
            && imagePath.split('/')[1] == request.auth.uid
            && imagePath.split('/')[2] == complaintId
            && request.resource.data.imageUrl.matches('^https://firebasestorage.googleapis.com/.*$')
          )
        )
        && documentPath is string
        && (
          (
            documentPath == ''
            && request.resource.data.documentUrl == ''
            && request.resource.data.documentName == ''
          )
          || (
            documentPath.matches('^complaints/[^/]+/[^/]+/document$')
            && documentPath.split('/')[1] == request.auth.uid
            && documentPath.split('/')[2] == complaintId
            && request.resource.data.documentUrl.matches('^https://firebasestorage.googleapis.com/.*$')
            && request.resource.data.documentName is string
            && request.resource.data.documentName.size() <= 255
          )
        )
        && (resource.data.imagePath == '' || imagePath == resource.data.imagePath)
        && (resource.data.documentPath == '' || documentPath == resource.data.documentPath);
    }

    match /handlers/{mobile} {
      allow read, write: if false;
    }

    match /handlerAccounts/{email} {
      allow get: if signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'apple.com']
        && request.auth.token.email == email;
      allow list, create, update, delete: if false;
    }

    match /securityLoginEvents/{eventId} {
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'apple.com']
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'provider', 'loginAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'displayName', 'provider', 'loginAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.provider == request.auth.token.firebase.sign_in_provider
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 200
        && request.resource.data.loginAt == request.time;
      allow read, update, delete: if false;
    }

    match /complaints/{complaintId} {
      allow create: if consumer()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == complaintId
        && request.resource.data.status == 'Pending'
        && request.resource.data.response == ''
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'location', 'issue', 'details',
          'ownerUid', 'status', 'response', 'imageUrl', 'imagePath',
          'documentUrl', 'documentPath', 'documentName', 'created',
          'updated', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'name', 'location', 'issue', 'details',
          'ownerUid', 'status', 'response', 'imageUrl', 'imagePath',
          'documentUrl', 'documentPath', 'documentName', 'created',
          'updated', 'createdAt'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 200
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 300
        && request.resource.data.issue is string
        && request.resource.data.issue.size() <= 100
        && request.resource.data.details is string
        && request.resource.data.details.size() > 0
        && request.resource.data.details.size() <= 1000
        && request.resource.data.response is string
        && request.resource.data.response == ''
        && request.resource.data.imageUrl is string
        && request.resource.data.imagePath is string
        && request.resource.data.documentUrl is string
        && request.resource.data.documentPath is string
        && request.resource.data.documentName is string
        && request.resource.data.created is string
        && request.resource.data.updated is string;

      allow get, list: if handler()
        || (consumer() && resource.data.ownerUid == request.auth.uid);

      allow update: if (
          handler()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'response', 'updated'])
          && request.resource.data.status in ['Pending', 'Under Review', 'Resolved', 'Rejected']
          && request.resource.data.response is string
          && request.resource.data.response.size() <= 1000
        )
        || consumerEvidenceUpdate(complaintId);

      allow delete: if false;
    }

    match /smsNotifications/{notificationId} {
      allow read, write: if false;
    }
  }
}
